# Build output
target/
dist/
hs_err_pid*.log

# IDE and OS files
.idea/
*.iml
.vscode/
.DS_Store

# App data written at runtime (uploads, analyses, exports)
data/

# Models and tools stay local: exported ONNX models, export weights and the Python environment,
# and the speech and notes programs and models fetched by packaging/get-models.ps1
models/*.onnx
models/whisper/
models/llm/
models/parakeet-tdt-0.6b-v3/
tools/
weights/
*.pt
.venv-model/

# Secrets and per-user settings never go into git
settings.json
.env
*.env
*.key

# Lambda tests and Terraform state and variables (secrets, account data)
infra/lambda/.venv/
__pycache__/
.pytest_cache/
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfstate.d/
infra/terraform.tfvars
infra/build/
infra/tfplan*

# Local working notes (not published)
docs/internal/
